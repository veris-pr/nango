{
    "scenario": "single_with_credentials_strips_refresh_token",
    "request": {
        "method": "GET",
        "path": "/connections/conn-1",
        "headers": { "Authorization": "Bearer {{secret_key}}" },
        "query": { "provider_config_key": "github", "refresh_token": "false" }
    },
    "seed": {
        "account": { "id": 1 },
        "environment": { "id": 1, "account_id": 1 },
        "customer_key": { "id": 10, "scopes": ["environment:connections:read_credentials"] },
        "integration": { "id": 100, "unique_key": "github", "provider": "github", "environment_id": 1 },
        "connection": {
            "id": 500,
            "connection_id": "conn-1",
            "provider_config_key": "github",
            "config_id": 100,
            "environment_id": 1,
            "tags": {},
            "metadata": null,
            "connection_config": {},
            "end_user": null,
            "active_logs": [],
            "credentials": {
                "type": "OAUTH2",
                "access_token": "secret-access",
                "refresh_token": "secret-refresh",
                "raw": { "refresh_token": "secret-refresh", "extra": "x" }
            },
            "last_fetched_at": "{{last_fetched_at}}",
            "created_at": "{{created_at}}",
            "updated_at": "{{updated_at}}"
        }
    },
    "response": {
        "status": 200,
        "body": {
            "id": 500,
            "connection_id": "conn-1",
            "provider_config_key": "github",
            "provider": "github",
            "errors": [],
            "end_user": null,
            "tags": {},
            "metadata": null,
            "connection_config": {},
            "created_at": "{{created_at}}",
            "updated_at": "{{updated_at}}",
            "last_fetched_at": "{{last_fetched_at}}",
            "credentials": { "type": "OAUTH2", "access_token": "secret-access", "raw": { "extra": "x" } }
        }
    },
    "notes": "read_credentials scope → full credentials. refresh_token=false strips refresh_token from credentials and from credentials.raw (for OAUTH2)."
}
