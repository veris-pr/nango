{
    "scenario": "list_missing_scope",
    "request": {
        "method": "GET",
        "path": "/connections",
        "headers": { "Authorization": "Bearer {{secret_key}}" },
        "query": {}
    },
    "seed": {
        "account": { "id": 1 },
        "environment": { "id": 1, "account_id": 1 },
        "customer_key": { "id": 10, "scopes": ["environment:integrations:read"] }
    },
    "response": {
        "status": 403,
        "body": {
            "error": {
                "code": "forbidden",
                "message": "Insufficient scope. Required one of: environment:connections:list or environment:connections:list_credentials"
            }
        }
    }
}
