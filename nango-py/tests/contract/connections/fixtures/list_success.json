{
    "scenario": "list_success",
    "request": {
        "method": "GET",
        "path": "/connections",
        "headers": { "Authorization": "Bearer {{secret_key}}" },
        "query": {}
    },
    "seed": {
        "account": { "id": 1, "name": "test-team" },
        "environment": { "id": 1, "name": "dev", "account_id": 1, "uuid": "{{environment_uuid}}" },
        "customer_key": { "id": 10, "scopes": ["environment:connections:list"] },
        "integration": { "id": 100, "unique_key": "github", "provider": "github", "environment_id": 1 },
        "connections": [
            {
                "id": 500,
                "connection_id": "conn-1",
                "provider_config_key": "github",
                "config_id": 100,
                "environment_id": 1,
                "tags": { "team": "alpha" },
                "metadata": { "region": "us" },
                "end_user": {
                    "end_user_id": "eu-1",
                    "email": "ada@example.com",
                    "display_name": "Ada",
                    "organization_id": "org-1",
                    "organization_display_name": "Acme"
                },
                "active_logs": [{ "type": "auth", "log_id": "log-9" }],
                "created_at": "{{created_at}}"
            }
        ]
    },
    "response": {
        "status": 200,
        "body": {
            "connections": [
                {
                    "id": 500,
                    "connection_id": "conn-1",
                    "provider_config_key": "github",
                    "provider": "github",
                    "errors": [{ "type": "auth", "log_id": "log-9" }],
                    "end_user": {
                        "id": "eu-1",
                        "display_name": "Ada",
                        "email": "ada@example.com",
                        "tags": null,
                        "organization": { "id": "org-1", "display_name": "Acme" }
                    },
                    "tags": { "team": "alpha" },
                    "metadata": { "region": "us" },
                    "created": "{{created_at}}"
                }
            ]
        }
    },
    "notes": "List items never include credentials. Key is `connections` (not `data`). `created` (not `created_at`). Ordered by created_at DESC."
}
