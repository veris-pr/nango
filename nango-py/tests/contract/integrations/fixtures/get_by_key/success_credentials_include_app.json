{
    "scenario": "success_credentials_include_app",
    "request": {
        "method": "GET",
        "path": "/integrations/github-app",
        "headers": { "Authorization": "Bearer {{secret_key}}" },
        "query": { "include": ["credentials"] }
    },
    "seed": {
        "account": { "id": 1, "name": "test-team", "uuid": "{{account_uuid}}" },
        "environment": { "id": 1, "name": "dev", "account_id": 1, "uuid": "{{environment_uuid}}", "is_production": false },
        "customer_key": { "id": 10, "key_type": "api", "scopes": ["environment:integrations:read_credentials"], "entity_type": "environment", "entity_id": 1 },
        "integration": {
            "id": 101,
            "unique_key": "github-app",
            "provider": "github-app",
            "environment_id": 1,
            "oauth_client_id": "app-id-123",
            "oauth_client_secret": "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----",
            "app_link": "https://example.com/install",
            "display_name": "GitHub App",
            "forward_webhooks": true,
            "shared_credentials_id": null,
            "deleted": false
        },
        "provider": { "name": "github-app", "auth_mode": "APP" }
    },
    "response": {
        "status": 200,
        "body": {
            "data": {
                "unique_key": "github-app",
                "provider": "github-app",
                "display_name": "GitHub App",
                "logo": "{{base_public_url}}/images/template-logos/github-app.svg",
                "forward_webhooks": true,
                "created_at": "{{created_at}}",
                "updated_at": "{{updated_at}}",
                "credentials": {
                    "type": "APP",
                    "app_id": "app-id-123",
                    "private_key": "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----",
                    "app_link": "https://example.com/install"
                }
            }
        }
    },
    "notes": "APP auth mode: oauth_client_id→app_id, oauth_client_secret→private_key, app_link included."
}
