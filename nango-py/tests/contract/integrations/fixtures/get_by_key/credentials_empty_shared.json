{
    "scenario": "credentials_empty_shared",
    "request": {
        "method": "GET",
        "path": "/integrations/github",
        "headers": {
            "Authorization": "Bearer {{secret_key}}"
        },
        "query": {
            "include": ["credentials"]
        }
    },
    "seed": {
        "account": {
            "id": 1,
            "name": "test-team",
            "uuid": "{{account_uuid}}"
        },
        "environment": {
            "id": 1,
            "name": "dev",
            "account_id": 1,
            "uuid": "{{environment_uuid}}",
            "is_production": false
        },
        "customer_key": {
            "id": 10,
            "key_type": "api",
            "scopes": ["environment:integrations:read_credentials"],
            "entity_type": "environment",
            "entity_id": 1
        },
        "integration": {
            "id": 100,
            "unique_key": "github",
            "provider": "github",
            "environment_id": 1,
            "oauth_client_id": "client-123",
            "oauth_client_secret": "secret-456",
            "oauth_scopes": "repo,user",
            "display_name": "GitHub",
            "forward_webhooks": true,
            "shared_credentials_id": null,
            "deleted": false
        },
        "shared_credentials": {
            "id": 55,
            "oauth_client_id": "shared-client",
            "oauth_client_secret": "shared-secret"
        },
        "provider": {
            "name": "github",
            "auth_mode": "OAUTH2"
        }
    },
    "response": {
        "status": 200,
        "body": {
            "data": {
                "unique_key": "github",
                "provider": "github",
                "display_name": "GitHub",
                "logo": "{{base_public_url}}/images/template-logos/github.svg",
                "forward_webhooks": true,
                "created_at": "{{created_at}}",
                "updated_at": "{{updated_at}}",
                "credentials": {
                    "type": "OAUTH2",
                    "client_id": "client-123",
                    "client_secret": "secret-456",
                    "scopes": "repo,user",
                    "webhook_secret": null
                }
            }
        }
    },
    "notes": "shared_credentials_id not set (providers_shared_credentials table not seeded); credentials returned as stored."
}
